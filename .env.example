# VAYU-Index Environment Configuration

# Database Connection (Default SQLite for local zero-config; PostgreSQL for production)
DATABASE_URL=sqlite:///./vayu_index.db
# DATABASE_URL=postgresql://vayu_user:vayu_password@localhost:5432/vayu_db

# APScheduler Background Intervals
APIX_RECALCULATE_INTERVAL_HOURS=6
FARE_SCRAPE_INTERVAL_HOURS=12

# API Server Config
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Frontend Vite
VITE_API_BASE_URL=http://localhost:8000/api
